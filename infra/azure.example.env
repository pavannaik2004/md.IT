# Copy to infra/azure.env (git-ignored) and fill in. Read by scripts/azure.sh and infra/bootstrap.sh.
# Never commit real values (P-116).

# The college subscription (Portal > Subscriptions > Subscription ID).
SUBSCRIPTION_ID=
# Written by infra/bootstrap.sh: the storage account that holds Terraform's state.
TFSTATE_ACCOUNT=
# Let's Encrypt issuer: staging for trial runs (untrusted certificate, no weekly limit),
# prod for a review (about 5 certificates per week for the same name).
ACME_ISSUER=staging

# OAuth apps (optional). Callbacks:
#   https://mdit.centralindia.cloudapp.azure.com/api/auth/callback/github
#   https://mdit.centralindia.cloudapp.azure.com/api/auth/callback/google
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
